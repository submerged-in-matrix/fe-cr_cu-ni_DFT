&CONTROL
    calculation = 'vc-relax',
    prefix = 'fe16cr00_vcrelax',
    pseudo_dir = './pseudo/',
    outdir = './tmp/',
    tstress = .true.,
    forc_conv_thr = 1.0d-5,
/
&SYSTEM
    ibrav = 0,
    nat = 16,
    ntyp = 1,
    ecutwfc = 60.0,
    ecutrho = 480.0,
    occupations = 'smearing',
    smearing = 'mv',
    degauss = 0.02,
    nspin = 2,
    starting_magnetization(1) = 0.5,
/
&ELECTRONS
    conv_thr = 1.0d-8,
    mixing_beta = 0.3
/
&IONS
    ion_dynamics = 'bfgs'
/
&CELL
    cell_dynamics = 'bfgs',
    press = 0.0,
    press_conv_thr = 0.5
/
